{
  "name": "fable-image-tracking",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "8th Wall-like markerless image tracking (natural feature tracking) built from scratch in TypeScript",
  "scripts": {
    "asbuild": "asc assembly/index.ts --outFile public/tracker.wasm -O3 --runtime stub --initialMemory 256 --maximumMemory 256",
    "dev": "npm run asbuild && vite --host",
    "build": "npm run asbuild && tsc --noEmit && vite build",
    "preview": "vite preview --host",
    "pretest": "npm run asbuild",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "three": "^0.166.1"
  },
  "devDependencies": {
    "@types/node": "^26.1.0",
    "@types/three": "^0.166.0",
    "@vitejs/plugin-basic-ssl": "^1.2.0",
    "assemblyscript": "^0.28.19",
    "typescript": "^5.5.4",
    "vite": "^5.4.11",
    "vitest": "^2.1.8"
  }
}
